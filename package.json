{
  "name": "robex",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev:all",
    "dev:all": "concurrently -n \"api,web\" -c \"blue,green\" \"npm run dev --workspace=@robex/api\" \"npm run dev --workspace=@robex/web\"",
    "dev:web": "npm run dev --workspace=@robex/web",
    "dev:api": "npm run dev --workspace=@robex/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint packages apps",
    "typecheck": "tsc --build --verbose",
    "test": "vitest run"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.21.0",
    "happy-dom": "^20.14.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
