# Robex Environment Configuration Example
# Copy this file to .env or .env.local for local development.
# NEVER commit real private keys or production secrets to Git.

# Environment Mode: 'development' | 'test' | 'production'
NODE_ENV=development
ROBEX_ENV=testnet

# API Server Configuration
API_PORT=3001
API_HOST=127.0.0.1
API_CORS_ORIGIN=http://localhost:5173

# Web Client Configuration (Vite requires VITE_ prefix for client-exposed vars)
VITE_API_URL=http://localhost:3001
VITE_DEFAULT_CHAIN_ID=46630
VITE_ENABLE_MOCK_WALLET=true

# Robinhood Chain Testnet public endpoints.
# Documented at https://docs.robinhood.com/chain/connecting (rate-limited).
# These variables override the defaults in packages/config.
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
ROBINHOOD_TESTNET_CHAIN_ID=46630
ROBINHOOD_TESTNET_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com

# Mainnet Configuration Placeholder (Disabled by default, human approval required for activation)
ROBINHOOD_MAINNET_RPC_URL=https://rpc.robinhood.com
ROBINHOOD_MAINNET_CHAIN_ID=46600
ROBINHOOD_MAINNET_EXPLORER_URL=https://explorer.robinhood.com
